# ── AWS ──
AWS_PROFILE=wine-rec-dev
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=

# ── S3 ──
S3_BUCKET=wine-rec-dev-data

# ── DynamoDB ──
DYNAMODB_FEATURES_TABLE=wine-rec-dev-features-online-v1
DYNAMODB_USER_PROFILE_TABLE=wine-rec-dev-user-profile-v1

# ── Kinesis ──
KINESIS_STREAM_NAME=wine-rec-dev-wine-events-stream

# ── SageMaker ──
SAGEMAKER_ROLE_ARN=
SAGEMAKER_INSTANCE_TYPE=ml.g4dn.xlarge

# ── Application ──
ENV=dev
LOG_LEVEL=DEBUG
LOG_FORMAT=json
